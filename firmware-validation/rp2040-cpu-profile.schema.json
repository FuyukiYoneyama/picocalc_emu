{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/picocalc/rp2040-cpu-profile.schema.json",
  "title": "PicoCalc RP2040 CPU application profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "record_id", "candidate_id", "workload", "backend", "runner", "cpu", "interval", "cores", "overflowed", "profile_valid", "counters", "invariants", "feature_set"],
  "properties": {
    "schema_id": {"const": "picocalc.rp2040-cpu-profile"},
    "schema_version": {"const": 1},
    "record_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "firmware_sha256", "scenario_sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "revision": {"type": "integer", "minimum": 1},
        "firmware_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "scenario_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "dirty"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "dirty": {"const": false}
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "build_provenance_sha256"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "build_provenance_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "cpu": {
      "type": "object",
      "required": ["model", "logical_cpus"],
      "properties": {
        "model": {"type": "string"},
        "logical_cpus": {"type": ["integer", "null"], "minimum": 1},
        "reported_mhz": {"type": ["number", "null"], "minimum": 0},
        "platform": {"type": "string"},
        "kernel": {"type": "string"}
      }
    },
    "interval": {
      "type": "object",
      "required": ["start_emulated_cycle", "end_emulated_cycle"],
      "properties": {
        "start_emulated_cycle": {"type": "integer", "minimum": 0},
        "end_emulated_cycle": {"type": "integer", "minimum": 0}
      }
    },
    "cores": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "overflowed": {"type": "boolean"},
    "profile_valid": {"type": "boolean"},
    "counters": {
      "type": "object",
      "required": ["active", "retired_instructions", "emulated_cycles", "pc_region", "decode", "invalidation", "exception", "handler_group"],
      "properties": {
        "active": {"type": "boolean"},
        "retired_instructions": {"type": "integer", "minimum": 0},
        "emulated_cycles": {"type": "integer", "minimum": 0},
        "pc_region": {"type": "object"},
        "decode": {"type": "object"},
        "invalidation": {"type": "object"},
        "exception": {"type": "object"},
        "handler_group": {"type": "object"}
      }
    },
    "invariants": {
      "type": "object",
      "required": ["valid"],
      "properties": {"valid": {"type": "boolean"}}
    },
    "feature_set": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "measurement": {"type": "object"},
    "raw_profile": {"type": "object"}
  }
}
