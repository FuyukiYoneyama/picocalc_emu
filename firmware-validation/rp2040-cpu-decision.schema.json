{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/picocalc/rp2040-cpu-decision.schema.json",
  "title": "PicoCalc RP2040 CPU candidate decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "record_id", "candidate_id", "decision_kind", "status", "workloads", "backend_identities", "feature_set"],
  "properties": {
    "schema_id": {"const": "picocalc.rp2040-cpu-decision"},
    "schema_version": {"const": 1},
    "record_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["pass", "fail", "bank", "pending", "invalid", "not_run"]},
    "decision_kind": {"enum": ["admission", "correctness", "performance", "profile", "null-control", "invalid"]},
    "hypothesis": {"type": "string"},
    "candidate_backend_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "baseline_backend_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "baseline_executable_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_executable_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "profile_runtime_parent": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "profile_only_delta": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "delta_files": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "runtime_semantics_changed": {"const": false},
    "correctness_record": {"type": "string", "minLength": 1},
    "firmware_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scenario_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "host": {"type": "object"},
    "toolchain": {"type": "object"},
    "feature_set": {"type": "array", "items": {"type": "string"}},
    "workloads": {"type": "array", "items": {"type": "object"}},
    "backend_identities": {"type": "object"},
    "workload": {"type": "string", "minLength": 1},
    "trace_required": {"type": "boolean"},
    "guest_observation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "registered_guest_observation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "baseline": {"type": "object"},
    "candidate": {"type": "object"},
    "runs": {"type": "array"},
    "backend_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "runner_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "build_provenance_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "behavior": {"type": "object"},
    "correctness": {"type": "object"},
    "statistics": {"type": "object"},
    "evidence": {"type": "array"},
    "reasons": {"type": "array", "items": {"type": "string"}},
    "artifacts": {"type": "object"},
    "measurement_policy": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inter_run_cooldown_seconds", "calibration_method", "anchor_layout",
            "anchor_run_ids", "correction_method", "anchor_residual_threshold",
            "pair_level_sensitivity_method"
          ],
          "properties": {
            "inter_run_cooldown_seconds": {"type": "number", "minimum": 0},
            "calibration_method": {"const": "interleaved-anchor-v1"},
            "anchor_layout": {
              "type": "object",
              "additionalProperties": false,
              "required": ["pre_count", "after_measured_runs", "post_count"],
              "properties": {
                "pre_count": {"const": 3},
                "after_measured_runs": {"const": [10, 20, 30]},
                "post_count": {"const": 3}
              }
            },
            "anchor_run_ids": {
              "const": [
                "anchor-pre-001", "anchor-pre-002", "anchor-pre-003",
                "anchor-after-010", "anchor-after-020", "anchor-after-030",
                "anchor-post-001", "anchor-post-002", "anchor-post-003"
              ]
            },
            "correction_method": {"const": "piecewise-linear-interpolation-of-log-baseline-anchor-throughput-v1"},
            "anchor_residual_threshold": {"const": 0.02},
            "pair_level_sensitivity_method": {"const": "raw-vs-host-corrected-log-ratio-v1"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inter_run_cooldown_seconds", "calibration_method", "anchor_layout",
            "anchor_group_ids", "anchor_run_ids", "correction_method",
            "anchor_aggregation_method", "anchor_residual_threshold",
            "anchor_group_dispersion_gate_used", "anchor_group_dispersion_threshold",
            "pair_level_sensitivity_method"
          ],
          "properties": {
            "inter_run_cooldown_seconds": {"type": "number", "minimum": 0},
            "calibration_method": {"const": "interleaved-anchor-v2"},
            "anchor_layout": {
              "type": "object",
              "additionalProperties": false,
              "required": ["pre_count", "after_measured_runs", "post_count", "replicates_per_group"],
              "properties": {
                "pre_count": {"const": 3},
                "after_measured_runs": {"const": [10, 20, 30]},
                "post_count": {"const": 3},
                "replicates_per_group": {"const": 3}
              }
            },
            "anchor_group_ids": {
              "const": ["pre", "after-010", "after-020", "after-030", "post"]
            },
            "anchor_run_ids": {
              "const": [
                "anchor-pre-001", "anchor-pre-002", "anchor-pre-003",
                "anchor-after-010-001", "anchor-after-010-002", "anchor-after-010-003",
                "anchor-after-020-001", "anchor-after-020-002", "anchor-after-020-003",
                "anchor-after-030-001", "anchor-after-030-002", "anchor-after-030-003",
                "anchor-post-001", "anchor-post-002", "anchor-post-003"
              ]
            },
            "correction_method": {"const": "piecewise-linear-interpolation-of-log-baseline-anchor-group-median-throughput-v2"},
            "anchor_aggregation_method": {"const": "median-of-replicate-log-throughput-v1"},
            "anchor_residual_threshold": {"const": 0.02},
            "anchor_group_dispersion_gate_used": {"const": true},
            "anchor_group_dispersion_threshold": {"const": 0.02},
            "pair_level_sensitivity_method": {"const": "raw-vs-host-corrected-log-ratio-v1"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["inter_run_cooldown_seconds"],
          "properties": {
            "inter_run_cooldown_seconds": {"type": "number", "minimum": 0}
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"decision_kind": {"const": "admission"}}},
      "then": {"required": ["evidence", "correctness"]}
    },
    {
      "if": {"properties": {"decision_kind": {"const": "correctness"}}},
      "then": {"required": ["correctness"]}
    },
    {
      "if": {"properties": {"decision_kind": {"const": "performance"}}},
      "then": {"required": ["statistics", "correctness"]}
    },
    {
      "if": {"properties": {"decision_kind": {"const": "null-control"}}},
      "then": {"required": ["statistics", "correctness"]}
    },
    {
      "if": {"properties": {"decision_kind": {"const": "profile"}}},
      "then": {"required": ["correctness"]}
    },
    {
      "if": {"properties": {"decision_kind": {"const": "invalid"}}},
      "then": {"required": ["reasons"]}
    }
  ]
}
