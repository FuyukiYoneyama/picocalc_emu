{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/picocalc/project-quality-contract.schema.json",
  "title": "PicoCalc external project quality contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "report_schema",
    "required_capabilities",
    "report_checks"
  ],
  "properties": {
    "schema_version": {"enum": [1, 2, 3]},
    "contract_id": {"type": "string", "minLength": 1},
    "report_schema": {"const": 8},
    "required_capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audio_sink"],
      "properties": {
        "audio_sink": {
          "type": "object",
          "additionalProperties": false,
          "required": ["expected_count", "expected_sha256"],
          "properties": {
            "expected_count": {"type": "integer", "minimum": 1},
            "expected_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "quality": {"type": "object"}
          }
        }
      }
    },
    "report_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "op", "value"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "op": {"enum": ["eq", "length_eq", "ge", "le"]},
          "value": {}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"schema_version": {"const": 2}},
        "required": ["schema_version"]
      },
      "then": {
        "properties": {
          "required_capabilities": {
            "properties": {
              "audio_sink": {
                "required": ["quality"],
                "properties": {"quality": {"$ref": "#/$defs/qualityV2"}}
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"schema_version": {"const": 3}},
        "required": ["schema_version"]
      },
      "then": {
        "properties": {
          "required_capabilities": {
            "properties": {
              "audio_sink": {
                "required": ["quality"],
                "properties": {"quality": {"$ref": "#/$defs/qualityV3"}}
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"schema_version": {"const": 1}},
        "required": ["schema_version"]
      },
      "then": {
        "properties": {
          "required_capabilities": {
            "properties": {
              "audio_sink": {"not": {"required": ["quality"]}}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "qualityV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_max_window_rms",
        "maximum_rail_sample_ratio_ppm",
        "maximum_consecutive_rail_frames"
      ],
      "properties": {
        "minimum_max_window_rms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "maximum_rail_sample_ratio_ppm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "maximum_consecutive_rail_frames": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "qualityV3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "advisory_minimum_max_window_rms",
        "maximum_rail_sample_ratio_ppm",
        "maximum_consecutive_rail_frames"
      ],
      "properties": {
        "advisory_minimum_max_window_rms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "maximum_rail_sample_ratio_ppm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "maximum_consecutive_rail_frames": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
