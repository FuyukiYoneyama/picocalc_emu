+/// Core 0 P1-A invalidation loop at 0x2000_0000:
+///   prologue: LDR R2, [PC, #8] | MOVS R1, #1
+///   loop:     ADDS R0, R0, #1 | STR R1, [R2]
+///             B loop
+///
+/// R2 points at 0x2000_4004.  RP2040 SRAM aliases share backing storage, and
+/// the 0x4000 offset maps the store onto the same direct-mapped decode-cache
+/// slots as instructions at 0x2000_0004/0x2000_0006.  The bytes being written
+/// are not the hot instructions, so P1-A should retain those cache entries
+/// while the pre-P1-A index-only invalidation clears them.
+fn setup_self_invalidate_core0(emu: &mut Emulator) {
+    const TARGET: u32 = 0x2000_4004;
+    emu.poke(0x2000_0000, 0x2101_4A02); // LDR R2 | MOVS R1
+    emu.poke(0x2000_0004, 0x6011_1C40); // ADDS R0,R0,#1 | STR R1,[R2]
+    emu.poke(0x2000_0008, 0xBF00_E7FC); // B .-8 | NOP
+    emu.poke(0x2000_000C, TARGET); // literal: colliding SRAM address
+
+    emu.core_mut(0).regs.set_pc(0x2000_0000);
+    emu.core_mut(0).regs.xpsr = 1 << 24;
+}
+
