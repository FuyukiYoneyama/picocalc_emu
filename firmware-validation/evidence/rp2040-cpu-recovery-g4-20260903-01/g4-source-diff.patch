+        .ok_or_else(|| {
+            invalid_request(format!("field '{field}' must be a non-negative integer"))
+        })?;
+    if !(min..=max).contains(&value) {
+        return Err(invalid_request(format!(
+            "field '{field}' must be in {min}..={max}"
