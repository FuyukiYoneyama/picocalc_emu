+        self.sequence = self.sequence.saturating_add(1);
+        let elapsed_s = now.duration_since(self.started_at).as_secs_f64();
+        let rate_mcycles_s = if elapsed_s > 0.0 {
+            cycles as f64 / elapsed_s / 1_000_000.0
+        } else {
+            0.0
+        };
