+            run_id,
+            pid: std::process::id(),
+            interval,
+            started_at,
+            next_deadline,
+            dispatches_since_check: 0,
+            sequence: 0,
+            enabled: true,
+        })
+    }
+
+    fn write_line(&mut self, line: String) {
+        if !self.enabled {
+            return;
+        }
