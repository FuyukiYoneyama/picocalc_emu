+            "[PICOCALC][RUN] event=finish run={} pid={} cycles={} elapsed_s={elapsed_s:.3} stop={} exit={}",
+            self.run_id,
+            self.pid,
+            outcome.cycles,
+            outcome.stop_reason.as_str(),
+            status.exit_code()
+        ));
+    }
