+        sensor.transaction_end();
+
+        assert!(sensor.address_phase(BMP280_ADDRESS));
+        assert!(sensor.write_byte(0x88));
+        assert!(sensor.address_phase(BMP280_ADDRESS));
+        let mut actual_calibration = [0u8; 24];
