+                "fixture.bus.sda_gpio",
+            )? != 6
+            || fixture_u64(
+                bus.get("scl_gpio")
+                    .ok_or_else(|| "fixture.bus.scl_gpio is required".to_string())?,
+                "fixture.bus.scl_gpio",
+            )? != 7
+            || fixture_u64(
