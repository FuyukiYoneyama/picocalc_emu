+            0x8c, 0x00, 0xf9, 0xff, 0x8c, 0x3c, 0xf8, 0xc6, 0x70, 0x17,
+        ];
+        let measurement = [0x65, 0x5a, 0xc0, 0x7e, 0xed, 0x00];
+        let mut invalid_calibration = calibration;
