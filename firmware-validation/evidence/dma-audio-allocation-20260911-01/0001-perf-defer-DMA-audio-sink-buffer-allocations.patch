diff --git a/crates/rp2040-emu/tests/dma_idle_allocations.rs b/crates/rp2040-emu/tests/dma_idle_allocations.rs
new file mode 100644
index 0000000..99ded33
--- /dev/null
+++ b/crates/rp2040-emu/tests/dma_idle_allocations.rs
@@ -0,0 +1,64 @@
+//! A dormant DMA tick must not allocate a disposable audio sink on the host.
+use rp2040_emu::bus::Bus;
+use std::alloc::{GlobalAlloc, Layout, System};
+use std::cell::Cell;
+use std::hint::black_box;
+
+struct CountingAllocator;
+
+thread_local! {
+    static TRACKING: Cell<bool> = const { Cell::new(false) };
+    static COUNTS: Cell<(usize, usize)> = const { Cell::new((0, 0)) };
+}
+
+fn count(allocations: usize, frees: usize) {
+    let _ = TRACKING.try_with(|tracking| {
+        if tracking.get() {
+            COUNTS.with(|counts| {
+                let (old_allocations, old_frees) = counts.get();
+                counts.set((old_allocations + allocations, old_frees + frees));
+            });
+        }
+    });
+}
+
+unsafe impl GlobalAlloc for CountingAllocator {
+    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+        let result = unsafe { System.alloc(layout) };
+        if !result.is_null() {
+            count(1, 0);
+        }
+        result
+    }
+
+    unsafe fn dealloc(&self, ptr: *mut u8, layout: Layout) {
+        count(0, 1);
+        unsafe { System.dealloc(ptr, layout) }
+    }
+}
+
+#[global_allocator]
+static ALLOCATOR: CountingAllocator = CountingAllocator;
+
+fn allocation_counts(mut operation: impl FnMut()) -> (usize, usize) {
+    COUNTS.with(|counts| counts.set((0, 0)));
+    TRACKING.with(|tracking| tracking.set(true));
+    for _ in 0..1_000 {
+        operation();
+    }
+    TRACKING.with(|tracking| tracking.set(false));
+    COUNTS.with(Cell::get)
+}
+
+#[test]
+fn dormant_dma_updates_do_not_allocate_or_free_audio_buffers() {
+    let mut bus = Bus::new();
+    // Exclude bus initialization, tracing initialization and report creation.
+    bus.tick_peripherals(1);
+    let before = bus.audio_sink_snapshot();
+    let direct = allocation_counts(|| black_box(&mut bus).tick_dma_with_cycles(black_box(1)));
+    let peripherals = allocation_counts(|| black_box(&mut bus).tick_peripherals(black_box(1)));
+    assert_eq!(bus.audio_sink_snapshot(), before);
+    assert_eq!(direct, (0, 0), "1,000 direct DMA updates");
+    assert_eq!(peripherals, (0, 0), "1,000 peripheral updates");
+}
