{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/picocalc/rp2040-cpu-ab.schema.json",
  "title": "PicoCalc RP2040 CPU paired A/B measurement",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "record_id", "candidate_id", "artifact_type"],
  "properties": {
    "schema_id": {"const": "picocalc.rp2040-cpu-ab"},
    "schema_version": {"const": 1},
    "record_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "artifact_type": {"enum": ["run", "summary", "correctness"]},
    "status": {"enum": ["pass", "invalid", "pending"]},
    "workload": {"type": "string", "minLength": 1},
    "baseline": {"type": "object"},
    "candidate": {"type": "object"},
    "trace_required": {"type": "boolean"},
    "pair": {"type": "integer", "minimum": 1},
    "order": {"enum": ["AB", "BA"]},
    "role": {"enum": ["baseline", "candidate"]},
    "run_id": {"type": "string", "pattern": "^run-[0-9]{3,}$"},
    "backend_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "runner_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "build_provenance_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "protocol_elapsed_seconds": {"type": "number", "minimum": 0},
    "predicted_anchor_throughput": {"type": "number", "exclusiveMinimum": 0},
    "host_speed_correction": {"type": "number", "exclusiveMinimum": 0},
    "corrected_emulated_cycles_per_wall_second": {"type": "number", "exclusiveMinimum": 0},
    "emulation_wall_ns": {"type": "integer", "minimum": 1},
    "emulation_wall_seconds": {"type": "number", "exclusiveMinimum": 0},
    "emulation_cpu_ns": {"type": "integer", "minimum": 1},
    "emulation_cpu_seconds": {"type": "number", "exclusiveMinimum": 0},
    "cycles_per_emulation_cpu_second": {"type": "number", "exclusiveMinimum": 0},
    "cycles_per_emulation_wall_second": {"type": "number", "exclusiveMinimum": 0},
    "predicted_anchor_cpu_throughput": {"type": "number", "exclusiveMinimum": 0},
    "corrected_emulated_cycles_per_cpu_second": {"type": "number", "exclusiveMinimum": 0},
    "primary_metric": {"enum": ["cpu-time", "wall-time"]},
    "primary_throughput": {"type": "number", "exclusiveMinimum": 0},
    "corrected_primary_throughput": {"type": "number", "exclusiveMinimum": 0},
    "cycles": {"type": "integer", "minimum": 1},
    "stop_reason": {"type": "string", "minLength": 1},
    "elapsed_us": {"type": "integer", "minimum": 0},
    "wall_ns": {"type": "integer", "minimum": 1},
    "wall_seconds": {"type": "number", "exclusiveMinimum": 0},
    "emulated_cycles_per_wall_second": {"type": "number", "exclusiveMinimum": 0},
    "baseline_guest_observation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_guest_observation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "guest_observation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "guest_observation_equal": {"type": "boolean"},
    "behavior_equal": {"type": "boolean"},
    "report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "uart_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "snapshot_sha256": {"type": "object"},
    "host_usage_delta": {"type": "object"},
    "log_ratio": {"type": "number"},
    "pairs": {"type": "integer", "minimum": 1},
    "measured_runs": {"type": "integer", "minimum": 1},
    "schedule": {"type": "object"},
    "calibration": {"type": "object"},
    "null_control": {"type": "object"},
    "workloads": {"type": "object"},
    "combined": {"type": "object"},
    "pair_results": {"type": "array"},
    "behavior": {"type": "object"},
    "host": {"type": "object"},
    "measurement_cpu": {"type": "integer", "minimum": 0},
    "cpu_affinity": {"type": "object"},
    "validity": {"type": "object"},
    "correctness_record": {"type": "string", "minLength": 1},
    "correctness_record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "error": {"type": "string"},
    "measurement_policy": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inter_run_cooldown_seconds", "calibration_method", "anchor_layout",
            "anchor_run_ids", "correction_method", "anchor_residual_threshold",
            "pair_level_sensitivity_method"
          ],
          "properties": {
            "inter_run_cooldown_seconds": {"type": "number", "minimum": 0},
            "primary_metric": {"enum": ["cpu-time", "wall-time"]},
            "calibration_method": {"const": "interleaved-anchor-v1"},
            "anchor_layout": {
              "type": "object",
              "additionalProperties": false,
              "required": ["pre_count", "after_measured_runs", "post_count"],
              "properties": {
                "pre_count": {"const": 3},
                "after_measured_runs": {"const": [10, 20, 30]},
                "post_count": {"const": 3}
              }
            },
            "anchor_run_ids": {
              "type": "array",
              "const": [
                "anchor-pre-001", "anchor-pre-002", "anchor-pre-003",
                "anchor-after-010", "anchor-after-020", "anchor-after-030",
                "anchor-post-001", "anchor-post-002", "anchor-post-003"
              ]
            },
            "correction_method": {"const": "piecewise-linear-interpolation-of-log-baseline-anchor-throughput-v1"},
            "anchor_residual_threshold": {"const": 0.02},
            "pair_level_sensitivity_method": {"const": "raw-vs-host-corrected-log-ratio-v1"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inter_run_cooldown_seconds", "calibration_method", "anchor_layout",
            "anchor_group_ids", "anchor_run_ids", "correction_method",
            "anchor_aggregation_method", "anchor_residual_threshold",
            "anchor_local_residual_method", "anchor_local_residual_threshold",
            "anchor_group_dispersion_gate_used", "anchor_group_dispersion_threshold",
            "pair_level_sensitivity_method", "pair_level_sensitivity_gate_used",
            "pair_level_sensitivity_threshold", "global_residual_diagnostic_only"
          ],
          "properties": {
            "inter_run_cooldown_seconds": {"type": "number", "minimum": 0},
            "primary_metric": {"enum": ["cpu-time", "wall-time"]},
            "calibration_method": {"const": "interleaved-anchor-v3"},
            "anchor_layout": {
              "type": "object",
              "additionalProperties": false,
              "required": ["pre_count", "after_measured_runs", "post_count", "replicates_per_group"],
              "properties": {
                "pre_count": {"const": 3},
                "after_measured_runs": {"const": [5, 10, 15, 20, 25, 30, 35]},
                "post_count": {"const": 3},
                "replicates_per_group": {"const": 3}
              }
            },
            "anchor_group_ids": {
              "const": ["pre", "after-005", "after-010", "after-015", "after-020", "after-025", "after-030", "after-035", "post"]
            },
            "anchor_run_ids": {
              "const": [
                "anchor-pre-001", "anchor-pre-002", "anchor-pre-003",
                "anchor-after-005-001", "anchor-after-005-002", "anchor-after-005-003",
                "anchor-after-010-001", "anchor-after-010-002", "anchor-after-010-003",
                "anchor-after-015-001", "anchor-after-015-002", "anchor-after-015-003",
                "anchor-after-020-001", "anchor-after-020-002", "anchor-after-020-003",
                "anchor-after-025-001", "anchor-after-025-002", "anchor-after-025-003",
                "anchor-after-030-001", "anchor-after-030-002", "anchor-after-030-003",
                "anchor-after-035-001", "anchor-after-035-002", "anchor-after-035-003",
                "anchor-post-001", "anchor-post-002", "anchor-post-003"
              ]
            },
            "correction_method": {"const": "piecewise-linear-interpolation-of-log-baseline-anchor-group-median-throughput-v3"},
            "anchor_aggregation_method": {"const": "median-of-replicate-log-throughput-v1"},
            "anchor_residual_threshold": {"const": 0.02},
            "anchor_local_residual_method": {"const": "leave-one-group-out-log-linear-v1"},
            "anchor_local_residual_threshold": {"const": 0.02},
            "anchor_group_dispersion_gate_used": {"const": true},
            "anchor_group_dispersion_threshold": {"const": 0.02},
            "pair_level_sensitivity_method": {"const": "raw-vs-host-corrected-log-ratio-v1"},
            "pair_level_sensitivity_gate_used": {"const": true},
            "pair_level_sensitivity_threshold": {"const": 0.02},
            "global_residual_diagnostic_only": {"const": true}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inter_run_cooldown_seconds", "calibration_method", "anchor_layout",
            "anchor_group_ids", "anchor_run_ids", "correction_method",
            "anchor_aggregation_method", "anchor_residual_threshold",
            "anchor_group_dispersion_gate_used", "anchor_group_dispersion_threshold",
            "pair_level_sensitivity_method"
          ],
          "properties": {
            "inter_run_cooldown_seconds": {"type": "number", "minimum": 0},
            "primary_metric": {"enum": ["cpu-time", "wall-time"]},
            "calibration_method": {"const": "interleaved-anchor-v2"},
            "anchor_layout": {
              "type": "object",
              "additionalProperties": false,
              "required": ["pre_count", "after_measured_runs", "post_count", "replicates_per_group"],
              "properties": {
                "pre_count": {"const": 3},
                "after_measured_runs": {"const": [10, 20, 30]},
                "post_count": {"const": 3},
                "replicates_per_group": {"const": 3}
              }
            },
            "anchor_group_ids": {
              "const": ["pre", "after-010", "after-020", "after-030", "post"]
            },
            "anchor_run_ids": {
              "const": [
                "anchor-pre-001", "anchor-pre-002", "anchor-pre-003",
                "anchor-after-010-001", "anchor-after-010-002", "anchor-after-010-003",
                "anchor-after-020-001", "anchor-after-020-002", "anchor-after-020-003",
                "anchor-after-030-001", "anchor-after-030-002", "anchor-after-030-003",
                "anchor-post-001", "anchor-post-002", "anchor-post-003"
              ]
            },
            "correction_method": {"const": "piecewise-linear-interpolation-of-log-baseline-anchor-group-median-throughput-v2"},
            "anchor_aggregation_method": {"const": "median-of-replicate-log-throughput-v1"},
            "anchor_residual_threshold": {"const": 0.02},
            "anchor_group_dispersion_gate_used": {"const": true},
            "anchor_group_dispersion_threshold": {"const": 0.02},
            "pair_level_sensitivity_method": {"const": "raw-vs-host-corrected-log-ratio-v1"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method", "pairs", "measured_runs", "order_schedule", "warmup_runs",
            "inter_run_cooldown_seconds", "calibration_method", "primary_metric",
            "secondary_metric", "affinity", "host_timing_scope", "diagnostic_only",
            "promotion_requires_full_production_ab"
          ],
          "properties": {
            "method": {"const": "paired-cpu-screening-v1"},
            "pairs": {"const": 2},
            "measured_runs": {"const": 8},
            "order_schedule": {"const": ["AB", "BA"]},
            "warmup_runs": {"const": 0},
            "inter_run_cooldown_seconds": {"const": 0},
            "calibration_method": {"const": "none"},
            "primary_metric": {"const": "cpu-time"},
            "secondary_metric": {"const": "wall-time"},
            "affinity": {"const": "single-vcpu"},
            "host_timing_scope": {"const": "picocalc-harness::run_loop"},
            "diagnostic_only": {"const": true},
            "promotion_requires_full_production_ab": {"const": true}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["inter_run_cooldown_seconds"],
          "properties": {
            "inter_run_cooldown_seconds": {"type": "number", "minimum": 0}
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"artifact_type": {"const": "run"}}},
      "then": {
        "required": ["run_id", "workload", "pair", "order", "role", "backend_commit", "runner_sha256", "build_provenance_sha256", "cycles", "stop_reason", "elapsed_us", "wall_ns", "wall_seconds", "emulated_cycles_per_wall_second", "report_sha256", "guest_observation_sha256", "host_usage_delta"]
      }
    },
    {
      "if": {"properties": {"artifact_type": {"const": "summary"}}},
      "then": {"required": ["pairs", "measured_runs", "workloads", "combined", "pair_results"]}
    },
    {
      "if": {"properties": {"artifact_type": {"const": "correctness"}}},
      "then": {
        "required": ["workload", "trace_required", "baseline", "candidate", "baseline_guest_observation_sha256", "candidate_guest_observation_sha256", "guest_observation_equal", "behavior_equal"]
      }
    },
    {
      "if": {
        "properties": {
          "artifact_type": {"const": "correctness"},
          "trace_required": {"const": true}
        }
      },
      "then": {"required": ["behavior"]}
    }
  ]
}
