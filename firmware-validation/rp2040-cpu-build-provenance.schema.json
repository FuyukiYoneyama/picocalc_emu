{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/picocalc/rp2040-cpu-build-provenance.schema.json",
  "title": "PicoCalc RP2040 CPU runner build provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id", "schema_version", "role", "backend_commit", "backend_dirty",
    "runner_sha256", "feature_set", "cargo_features", "cargo_tree_features", "effective_features_sha256",
    "lockfile_sha256", "cargo_tree_sha256", "cargo_argv", "rustc_version", "cargo_version"
  ],
  "properties": {
    "schema_id": {"const": "picocalc.rp2040-build-provenance"},
    "schema_version": {"const": 1},
    "role": {
      "enum": [
        "baseline_production", "candidate_production", "baseline_trace",
        "candidate_trace", "candidate_profile", "production"
      ]
    },
    "backend_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "backend_dirty": {"const": false},
    "runner_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "feature_set": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "cargo_features": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "cargo_tree_features": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "effective_features_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "lockfile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cargo_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cargo_argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "rustc_version": {"type": "string", "minLength": 1},
    "cargo_version": {"type": "string", "minLength": 1}
  }
}
