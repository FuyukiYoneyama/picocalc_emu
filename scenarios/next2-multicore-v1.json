        "text": "[NEXT2][MC][VERDICT] launch=pass fifo=pass wfe_sev=pass irq_proc1=pass overall=pass"
      }
    },
    {
      "op": "snapshot",
      "label": "NEXT-2A final PASS screen",
      "png": "next2-multicore-final.png"
    }
  ]
}
