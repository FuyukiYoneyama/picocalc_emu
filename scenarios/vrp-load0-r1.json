{
  "schema": 1,
  "name": "vrp-load0-r1-vertical-slice",
  "description": "Repository-owned sustained-load vertical slice. The firmware fixes the display/audio/CPU workload; this scenario supplies two explicit keyboard press/release pairs after startup and stops only after the firmware's deterministic completion marker.",
  "poll_ms": 5,
  "steps": [
    {
      "op": "wait_until",
      "label": "workload started",
      "timeout_ms": 20000,
      "condition": {
        "kind": "uart_contains",
        "text": "[VRP-LOAD0][START]"
      }
    },
    {
      "op": "wait",
      "label": "fixed input offset",
      "ms": 1000
    },
    {
      "op": "key_events",
      "label": "fixed input sequence",
      "gap_ms": 250,
      "events": [
        {
          "state": "pressed",
          "code": 4
        },
        {
          "state": "released",
          "code": 4
        },
        {
          "state": "pressed",
          "code": 5
        },
        {
          "state": "released",
          "code": 5
        }
      ]
    },
    {
      "op": "wait_until",
      "label": "workload completed",
      "timeout_ms": 130000,
      "condition": {
        "kind": "uart_contains",
        "text": "[VRP-LOAD0][COMPLETE]"
      }
    }
  ]
}
