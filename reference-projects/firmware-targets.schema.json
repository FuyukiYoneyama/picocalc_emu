{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/picocalc/firmware-targets.schema.json",
  "title": "PicoCalc firmware conformance target registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy", "targets"],
  "properties": {
    "schema_version": {"const": 3},
    "policy": {"type": "string", "minLength": 1},
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/target"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "revision", "status", "source", "toolchain", "build", "artifacts",
        "backend", "runner", "scenario", "acceptance", "validation"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "revision": {"type": "integer", "minimum": 1},
        "supersedes": {"type": ["string", "null"]},
        "status": {"enum": ["active", "pending-revalidation"]},
        "status_reason": {"type": "string"},
        "source": {"type": "object", "minProperties": 2},
        "toolchain": {"type": "object", "minProperties": 2},
        "build": {"type": "object", "minProperties": 1},
        "artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bin_basename", "bin_sha256"],
          "properties": {
            "bin_basename": {"type": "string", "minLength": 1},
            "bin_sha256": {"$ref": "#/$defs/sha256"},
            "elf_sha256": {"$ref": "#/$defs/sha256"},
            "uf2_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "backend": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repo", "branch", "accepted", "report_schema"],
          "properties": {
            "repo": {"const": "picoem-picocalc"},
            "branch": {"type": "string", "minLength": 1},
            "accepted": {"$ref": "#/$defs/commit"},
            "report_schema": {"const": 8}
          }
        },
        "runner": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "board", "lcd_variant", "cycles", "quantum", "psram",
            "keyboard", "sd"
          ],
          "properties": {
            "board": {"enum": ["none", "picocalc"]},
            "lcd_variant": {"enum": ["hwspi-rgb888", "pio-rgb565"]},
            "cycles": {"type": "integer", "minimum": 1},
            "quantum": {"type": "integer", "minimum": 1},
            "stop_pc": {"type": ["string", "null"]},
            "psram": {"type": "boolean"},
            "psram_verify_range": {"type": "string"},
            "keyboard": {"type": "boolean"},
            "keys": {"type": ["string", "null"]},
            "sd": {
              "type": "object",
              "additionalProperties": false,
              "required": ["attached", "format"],
              "properties": {
                "attached": {"type": "boolean"},
                "format": {"enum": ["fat32", "fat16"]}
              }
            }
          }
        },
        "scenario": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "sha256": {"$ref": "#/$defs/sha256"}
              }
            }
          ]
        },
        "acceptance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["expected_stop_reason", "required_uart_markers", "report_checks"],
          "properties": {
            "expected_stop_reason": {
              "enum": ["cycle_limit", "pc_match", "scenario_done"]
            },
            "required_uart_markers": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            },
            "normalized_report_sha256": {"$ref": "#/$defs/sha256"},
            "timeline_sha256": {"$ref": "#/$defs/sha256"},
            "report_checks": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "op", "value"],
                "properties": {
                  "path": {"type": "string", "minLength": 1},
                  "op": {"enum": ["eq", "length_eq"]},
                  "value": {}
                }
              }
            }
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["record", "sha256"],
          "properties": {
            "record": {"type": "string", "minLength": 1},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    }
  }
}
