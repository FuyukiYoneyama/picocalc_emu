{
  "schema_version": 1,
  "protocol": "picocalc-preview-ipc",
  "status": "frozen_for_vrp0",
  "scope": "local process-to-process only; not a network API",
  "transport": {
    "kind": "local-duplex-pipes",
    "runner_to_preview": "child stdout",
    "preview_to_runner": "child stdin",
    "diagnostics": "child stderr",
    "stdout_rule": "only framed protocol bytes; no human-readable logs"
  },
  "framing": {
    "header_size_bytes": 16,
    "magic_ascii": "PCRP",
    "magic_hex": "50435250",
    "version": {"encoding": "uint16_le", "value": 1},
    "message_kind": {"encoding": "uint16_le", "values": "see message_kinds"},
    "payload_length": {"encoding": "uint32_le", "maximum": 8388608},
    "sequence": {"encoding": "uint32_le", "per_direction": true, "initial_value": 0},
    "byte_order": "little-endian for all integer fields",
    "frame_layout": ["magic[4]", "version[2]", "kind[2]", "payload_length[4]", "sequence[4]"],
    "length_rule": "payload_length counts bytes after the 16-byte header"
  },
  "encoding": {
    "control_json": "UTF-8, compact separators, recursively sorted object keys, no NaN or Infinity",
    "binary_integer_encoding": "little-endian",
    "rgb565": "one uint16_le pixel per pixel, row-major",
    "pcm": "signed 16-bit little-endian interleaved samples",
    "checksum": "none; local pipes are not a persistence or network transport"
  },
  "message_kinds": [
    {"kind": 1, "name": "hello", "direction": "runner_to_preview", "payload": "canonical_json"},
    {"kind": 2, "name": "status", "direction": "runner_to_preview", "payload": "canonical_json"},
    {"kind": 3, "name": "frame_rgb565", "direction": "runner_to_preview", "payload": "u64 cycle + u16 width + u16 height + pixels"},
    {"kind": 4, "name": "audio_pcm_s16", "direction": "runner_to_preview", "payload": "u64 cycle + u32 sample_rate + u16 channels + u16 frames + samples"},
    {"kind": 5, "name": "key_event", "direction": "preview_to_runner", "payload": "canonical_json"},
    {"kind": 6, "name": "reset", "direction": "preview_to_runner", "payload": "empty"},
    {"kind": 7, "name": "quit", "direction": "preview_to_runner", "payload": "empty"},
    {"kind": 8, "name": "uart_tx", "direction": "runner_to_preview", "payload": "u64 cycle + u8 byte"},
    {"kind": 9, "name": "uart_rx", "direction": "preview_to_runner", "payload": "u8 byte"},
    {"kind": 10, "name": "error", "direction": "runner_to_preview", "payload": "canonical_json"},
    {"kind": 11, "name": "goodbye", "direction": "runner_to_preview", "payload": "canonical_json"}
  ],
  "payload_rules": {
    "hello": {"required_keys": ["protocol", "role", "schema"], "protocol": "preview-ipc", "schema": 1},
    "key_event": {"required_keys": ["key", "state"], "state_values": ["down", "held", "up"], "host_time": "not encoded"},
    "frame_rgb565": {"prefix": "cycle u64_le, width u16_le, height u16_le", "pixel_bytes": "width * height * 2"},
    "audio_pcm_s16": {"prefix": "cycle u64_le, sample_rate u32_le, channels u16_le, frames u16_le", "sample_bytes": "frames * channels * 2", "max_frames_per_block": 128},
    "uart_tx": {"length_bytes": 9, "cycle": "u64_le", "byte": "u8"},
    "uart_rx": {"length_bytes": 1, "byte": "u8"},
    "empty_commands": ["reset", "quit"]
  },
  "fail_closed": {
    "reject": [
      "bad magic",
      "unsupported version",
      "unknown message kind",
      "direction/kind mismatch",
      "payload length greater than 8388608",
      "truncated header or payload",
      "sequence discontinuity within one direction",
      "malformed or non-canonical JSON",
      "binary payload length mismatch",
      "audio_pcm_s16 frame count greater than 128"
    ],
    "action": "emit one diagnostic to stderr, do not reinterpret bytes as another kind, and terminate the preview session"
  }
}
