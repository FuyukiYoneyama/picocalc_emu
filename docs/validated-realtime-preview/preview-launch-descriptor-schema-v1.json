{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/picocalc/validated-realtime-preview/launch-descriptor-v1.json",
  "title": "PicoCalc validated realtime preview launch descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "receipt_id", "target", "firmware",
    "backend", "report", "device", "launch"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "admitted"},
    "receipt_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "contract_sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "revision": {"type": "integer", "minimum": 1},
        "contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "firmware": {"$ref": "#/$defs/path_hash"},
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory", "commit", "runner"],
      "properties": {
        "directory": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "runner": {"$ref": "#/$defs/path_hash"}
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "schema_version"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "schema_version": {"const": 8}
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["board", "lcd_variant", "psram", "keyboard", "sd"],
      "properties": {
        "board": {"const": "picocalc"},
        "lcd_variant": {"type": "string"},
        "psram": {"type": "boolean"},
        "keyboard": {"type": "boolean"},
        "sd": {
          "type": "object",
          "additionalProperties": false,
          "required": ["attached", "format"],
          "properties": {
            "attached": {"type": "boolean"},
            "format": {"enum": ["fat16", "fat32"]}
          }
        }
      }
    },
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gui_started", "preview_ipc_schema", "contract", "contract_sha256"],
      "properties": {
        "gui_started": {"const": false},
        "preview_ipc_schema": {"const": 1},
        "contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "mode", "cwd", "argv", "bootrom"],
          "properties": {
            "schema_version": {"const": 1},
            "mode": {"const": "preview-api"},
            "cwd": {"type": "string", "minLength": 1},
            "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "bootrom": {"$ref": "#/$defs/path_hash"}
          }
        },
        "contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "$defs": {
    "path_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
